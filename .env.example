# Скопируйте в .env для локального запуска. Файл .env в Git НЕ коммитится.
GEMINI_API_KEY=вставьте_ключ_из_Google_AI_Studio
SECRET_KEY=длинная_случайная_строка
# Точные имена моделей смотрите в Google AI Studio; список через запятую = запасные модели по порядку.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# ASSISTANT_NAME=Химолик
# DEBUG=true            # только локально: включает /docs
